# Django settings
SECRET_KEY=django-insecure-petcare-clinic-system-super-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# DeepSeek Chatbot
# Obtenha sua chave em: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Envio de E-mail (Exemplo: Gmail, SendGrid, Mailgun)
# Se deixar em branco, o Django usará console backend (imprime os emails no terminal em DEBUG=True)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app-aqui
DEFAULT_FROM_EMAIL=PetCare Clínica Veterinária <seu-email@gmail.com>

# WhatsApp (Configurações opcionais para a sua implementação da função placeholder)
# Exemplo: Evolution API, Z-API, Twilio, Meta Cloud API, etc.
WHATSAPP_API_URL=https://api.seuzap.com/send
WHATSAPP_API_TOKEN=seu_token_aqui
